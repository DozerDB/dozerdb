{
  "name": "procedures",
  "root": "procedures",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "scripts/maven.sh -pl procedures -am install -DskipTests",
        "cwd": "."
      },
      "outputs": [
        "{projectRoot}/target"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "scripts/maven.sh -pl procedures -am verify",
        "cwd": "."
      },
      "outputs": [
        "{projectRoot}/target/surefire-reports",
        "{projectRoot}/target/failsafe-reports"
      ]
    }
  }
}
